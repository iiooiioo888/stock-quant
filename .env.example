# stock-quant 配置
# 所有配置項都可以用 SQ_ 前綴的環境變量覆蓋

# ====== 應用 ======
SQ_DEBUG=false
SQ_LOG_LEVEL=INFO

# ====== 安全（重要：生產環境必須設置） ======
# SQ_JWT_SECRET=your-random-secret-here-at-least-32-chars
# 首次啟動會在 data/.admin_password 生成隨機管理員密碼
# 請登錄後立即修改密碼

# ====== Web 服務 ======
SQ_WEB_HOST=0.0.0.0
SQ_WEB_PORT=8000
SQ_WEB_WORKERS=1
# 生產環境請設置具體域名，不要用 *
SQ_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ====== WebSocket 安全 ======
# 本地/演示可 false；非演示模式未設置時默認強制認證
# SQ_WS_AUTH_REQUIRED=false

# ====== 數據庫 ======
# SQ_DB_PATH=/app/data/stock.db

# ====== 歷史數據（主源 Yahoo Finance，代碼自動映射 .SS/.SZ） ======
# SQ_HISTORY_START_DATE=20200101

# ====== 盯盤 ======
# SQ_POLL_INTERVAL_SEC=10
# SQ_ALERT_COOLDOWN_SEC=300

# ====== 回測 ======
# SQ_BACKTEST_CASH=100000
# SQ_BACKTEST_COMMISSION=0.001
# SQ_BACKTEST_STAMP_TAX=0.001

# ====== 策略參數（JSON，覆蓋 config.py 默認） ======
# 例：SQ_STRATEGY_PARAMS__DUAL_MA__FAST=8
# 完整列表見 GET /api/strategies/params 或 GET /api/config

# ====== 任務並行 ======
# SQ_TASK_MAX_WORKERS：同時運行的 API 異步任務槽位（0=自動，約 min(4, CPU-1)）
# SQ_MULTI_STRATEGY_WORKERS / SQ_TASK_GRID_WORKERS：單一任務「內部」並行，受 compute_budget 再縮限
# SQ_TASK_MAX_WORKERS=0
# SQ_TASK_PARALLEL_GRID=true
# SQ_TASK_GRID_WORKERS=0
# SQ_OPTUNA_N_JOBS=0
# SQ_MULTI_STRATEGY_WORKERS=4
# SQ_OPTIMIZE_ALL_WORKERS=2
# SQ_OPTIMIZE_ALL_PARALLEL=false
# SQ_TASK_PROGRESS_SAVE_INTERVAL_SEC=2.0

# ====== 緩存 ======
# SQ_CACHE_ENABLED=true
# SQ_CACHE_BACKTEST_TTL=3600
# SQ_CACHE_OPTIMIZE_TTL=7200
# SQ_CACHE_PORTFOLIO_TTL=3600

# ====== Redis（Docker Compose 默認啟用；本地直跑可關閉） ======
# SQ_REDIS_ENABLED=false
# SQ_REDIS_URL=redis://:password@localhost:6379/0
# SQ_REDIS_PASSWORD=stockquant_redis_2024

# ====== Docker Compose 可選 ======
# NGINX_HTTP_PORT=80
# SQ_DEMO_MODE=false

# ====== 定時任務 (APScheduler，服務啟動時自動註冊) ======
# SQ_SCHEDULER_ENABLED=true
# SQ_SCHEDULER_AUTO_REGISTER=true
# SQ_SCHEDULER_JOB_INCREMENTAL=true
# SQ_SCHEDULER_JOB_DAILY_REPORT=true
# SQ_SCHEDULER_JOB_DATA_QUALITY=true
# SQ_SCHEDULER_JOB_DEGRADATION=false
# SQ_SCHEDULER_JOB_CORRELATION=false
# SQ_SCHEDULER_JOB_LEADERBOARD=true
# SQ_SCHEDULER_INCREMENTAL_HOUR=8
# SQ_SCHEDULER_INCREMENTAL_MINUTE=5

# ====== Polymarket 預測市場（只讀 + 概率預警/策略信號） ======
# SQ_CRYPTO_ENABLED=true

# SQ_POLYMARKET_ENABLED=true
# SQ_POLYMARKET_ALERT_ENABLED=true
# SQ_POLYMARKET_ALERT_POLL_SEC=300
# SQ_POLYMARKET_ALERT_COOLDOWN_SEC=300
# SQ_SCHEDULER_JOB_POLYMARKET_ALERTS=true
# SQ_POLYMARKET_WATCHLIST_SLUGS=will-trump-win-2024
# SQ_POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
# SQ_POLYMARKET_CLOB_BASE=https://clob.polymarket.com

# ====== MCP（全項目 stdio Server，可選依賴 requirements-mcp.txt） ======
# 啟動: python -m src.integrations.mcp.server
# 文檔: docs/MCP.md（含 sq_* 核心域 + polymarket_* 等業務域）

# ====== 限流 ======
# SQ_RATE_LIMIT_PER_MINUTE=120

# ====== 通知 ======
# SQ_NOTIFY_WEBHOOK=false
# SQ_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx

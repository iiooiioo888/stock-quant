# stock-quant 環境變量範例（複製為 .env 後修改）
# 前綴 SQ_ 對應 src/config.py Settings

# ====== 資料源 ======
SQ_YAHOO_ENABLED=true
SQ_AKSHARE_ENABLED=true
SQ_YAHOO_REQUEST_INTERVAL=1.0
SQ_YAHOO_MAX_RETRIES=3

# ====== 批量下載 ======
SQ_DOWNLOAD_MAX_WORKERS=3
SQ_DOWNLOAD_THROTTLE_SEC=0.5

# ====== Interactive Brokers（可選，需本機 TWS/Gateway） ======
SQ_IB_ENABLED=false
# SQ_IB_HOST=127.0.0.1
# SQ_IB_PORT=7497
# SQ_IB_CLIENT_ID=10

# ====== 安全（生產務必改密） ======
# SQ_JWT_SECRET=
SQ_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SQ_WS_AUTH_REQUIRED=true
SQ_ALLOW_STRATEGY_UPLOAD=false
SQ_DEMO_MODE=false

# ====== Redis（Docker Compose 預設啟用） ======
SQ_REDIS_ENABLED=false
# SQ_REDIS_URL=redis://:changeme@127.0.0.1:6379/0
# SQ_REDIS_PASSWORD=

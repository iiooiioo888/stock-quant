# stock-quant 配置
# 所有配置項都可以用 SQ_ 前綴的環境變量覆蓋

# ====== 應用 ======
SQ_DEBUG=false
SQ_LOG_LEVEL=INFO

# ====== 安全（重要：生產環境必須設置） ======
# SQ_JWT_SECRET=your-random-secret-here-at-least-32-chars
# 首次啟動會在 data/.admin_password 生成隨機管理員密碼
# 請登錄後立即修改密碼

# ====== Web 服務 ======
SQ_WEB_HOST=0.0.0.0
SQ_WEB_PORT=8000
SQ_WEB_WORKERS=1
# 生產環境請設置具體域名，不要用 *
SQ_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ====== WebSocket 安全 ======
# 生產環境必須設為 true（默認），開發環境可設為 false
# SQ_WS_AUTH_REQUIRED=true

# ====== 數據庫 ======
# SQ_DB_PATH=/app/data/stock.db

# ====== 歷史數據 ======
# SQ_HISTORY_START_DATE=20200101

# ====== 盯盤 ======
# SQ_POLL_INTERVAL_SEC=10
# SQ_ALERT_COOLDOWN_SEC=300

# ====== 回測 ======
# SQ_BACKTEST_CASH=100000
# SQ_BACKTEST_COMMISSION=0.001

# ====== Redis ======
# SQ_REDIS_ENABLED=false
# SQ_REDIS_URL=redis://:password@localhost:6379/0
# SQ_REDIS_PASSWORD=your_redis_password

# ====== 限流 ======
# SQ_RATE_LIMIT_PER_MINUTE=120

# ====== 通知 ======
# SQ_NOTIFY_WEBHOOK=false
# SQ_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
